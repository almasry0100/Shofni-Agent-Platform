# Shofni Agent Platform
# Copy this file to .env locally and fill only the values you need.
# Never commit the real .env file.

# ------------------------------------------------------------
# Initial live providers
# ------------------------------------------------------------
A6API_KEY=
RELAYROUTER_API_KEY=

A6API_BASE_URL=https://api.a6api.com
RELAYROUTER_BASE_URL=https://api.relayrouter.org/v1

# ------------------------------------------------------------
# Shofni runtime / diagnostics
# ------------------------------------------------------------
SHOFNI_LOG_LEVEL=info
SHOFNI_EVIDENCE_REDACT_SECRETS=true

# Leave blank until a POC backend is intentionally selected.
SHOFNI_GATEWAY_BACKEND=
SHOFNI_RUNTIME_BACKEND=

# Optional disposable POC workspace.
POC_WORKSPACE_DIR=

# ------------------------------------------------------------
# Optional / future providers and control baselines
# These are NOT required initial live providers.
# ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
